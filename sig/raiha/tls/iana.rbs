  def self.cipher_suite_name: (Integer v) -> Symbol?
  def self.alert_name: (Integer v) -> Symbol?
  def self.alert_code: (Symbol name) -> Integer
  def self.label: (Hash[Integer, Symbol] table, Integer v) -> String
  def self.grease?: (Integer v) -> bool
end
