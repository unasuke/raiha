module Raiha::TLS::IANA
  CIPHER_SUITES: Hash[Integer, Symbol]
  NAMED_GROUPS: Hash[Integer, Symbol]
  EXTENSIONS: Hash[Integer, Symbol]
  ALERTS: Hash[Integer, Symbol]
