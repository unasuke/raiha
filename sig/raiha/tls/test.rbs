    CLIENT_EARLY_TRAFFIC_SECRET: String
    CLIENT_HANDSHAKE_TRAFFIC_SECRET: String
    SERVER_HANDSHAKE_TRAFFIC_SECRET: String
    CLIENT_APPLICATION_TRAFFIC_SECRET_0: String
    SERVER_APPLICATION_TRAFFIC_SECRET_0: String
