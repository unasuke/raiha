module Raiha::Next::TLS
  module Test
    class FixedRandom
      @chunks: Array[String]

      def initialize: (*String chunks) -> void
      def bytes: (Integer length) -> String
    end

    class FixedKEM
      @private_keys: Hash[Symbol, String]
      @provider: KeyExchange::OpenSSL

      def initialize: (Hash[Symbol, String] private_keys) -> void
      def supported_groups: () -> Array[Symbol]
      def generate: (Symbol group) -> KeyExchange::KeyPair
      def encapsulate: (Symbol group, String peer_public_bytes) -> [String, String]?
      def decapsulate: (KeyExchange::KeyPair key_pair, String ciphertext) -> String?
    end
  end
end

module Raiha::Next::TLS::Test::RFC8448
  SERVER_RSA_PRIVATE_KEY: String

  type section = :simple_1rtt | :hello_retry_request | :client_authentication | :resumed_0rtt

  def self.machine: (section section, :client | :server role, now: Time, ?keylog: Raiha::Next::TLS::Keylog::_Writer?) -> Raiha::Next::TLS::Handshake::Machine
  def self.server_identity: () -> Raiha::Next::TLS::Keyring::Identity
  def self.resumed_client: (now: Time, keylog: Raiha::Next::TLS::Keylog::_Writer?) -> Raiha::Next::TLS::Handshake::Machine
  def self.section3_session: (now: Time) -> Raiha::Next::TLS::Session

