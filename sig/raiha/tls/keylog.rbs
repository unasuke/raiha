module Raiha::Next::TLS
  module Keylog
    # What a Machine writes its keylog lines to. A File works as is.
    interface _Writer
      def write: (String line) -> untyped
    end

    LABELS: Hash[Symbol, String]

    def self.line: (Symbol name, String client_random, String secret) -> String

    class File
      @io: ::File

      def initialize: (String path) -> void
      def write: (String line) -> Integer
      def close: () -> nil
    end
  end
end
