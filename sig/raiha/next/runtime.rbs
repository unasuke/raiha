module Raiha::Next::Runtime
  module Error
    class Base < StandardError
    end

    class Usage < Base
    end
  end

  # What a client or a server of the runtime is to its Driver.
  interface _Owner
    def route: (Raiha::Next::QUIC::Route::t route, Float now) -> void

    def turn: (Float now) -> void

    def next_timeout: () -> Float?

    def stopped: (StandardError? failure) -> void
  end

  class Driver
    attr_reader endpoint: Raiha::Next::QUIC::Endpoint
    attr_reader failure: StandardError?

    @udp: UDP
    @owner: _Owner
    @lock: Thread::Mutex
    @changed: Thread::ConditionVariable
    @dirty: bool
    @stopped: bool

    def self.clock: () -> Float

    def initialize: (Raiha::Next::QUIC::Endpoint endpoint, UDP udp, _Owner owner) -> void

    def start: () -> self

    def changed: () -> void

    def stopped?: () -> bool

    def stop: () -> void

    private def read: () -> void

    private def take: (Array[[String, UDP::address, UDP::ecn]] datagrams, Float now) -> Array[Raiha::Next::QUIC::Transmit]

    private def run: () -> void

    private def turn: (Float now) -> Array[Raiha::Next::QUIC::Transmit]

    private def timeout: () -> Float?

    private def fail: (StandardError error) -> void
  end

  class UDP
    type address = [String, Integer]

    RECEIVE_BATCH: Integer
    MAX_DATAGRAM: Integer
    BUFFER: Integer
    type ecn = Raiha::Next::QUIC::ecn | :ce

    ECN: Hash[Integer, ecn]
    MARKS: Hash[Symbol, Integer]
    DROPPED: Array[singleton(SystemCallError)]

    @socket: UDPSocket
    @family: Integer

    def self.bind: (String host, Integer port) -> UDP

    def initialize: (UDPSocket socket) -> void

    def local_address: () -> address

    def send: (Raiha::Next::QUIC::Transmit transmit) -> bool

    def receive: () -> Array[[String, address, ecn]]

    def wait_readable: (?(Float | Integer)? timeout) -> bool

    def close: () -> void

    def closed?: () -> bool

    private def datagrams: (Raiha::Next::QUIC::Transmit transmit) -> Array[String]

    private def mark: (Symbol ecn, String host) -> Socket::AncillaryData?

    private def ecn: (Array[Socket::AncillaryData] controls) -> ecn
  end
end

module Raiha::Next::Runtime
  class StreamReset < StandardError
    attr_reader stream_id: Integer
    attr_reader error_code: Integer

    def initialize: (Integer stream_id, Integer error_code) -> void
  end

  class Session
    attr_reader connection: Raiha::Next::QUIC::Connection

    @driver: Driver
    @role: :client | :server
    @lock: Thread::Mutex
    @changed: Thread::ConditionVariable
    @waiting: Integer
    @incoming: Array[Integer]
    @known: Hash[Integer, true]
    @resets: Hash[Integer, Integer]
    @stops: Hash[Integer, Integer]

    def initialize: (Raiha::Next::QUIC::Connection connection, Driver driver, role: :client | :server) -> void

    def open_stream: (?direction: :bidi | :uni) -> Stream

    def accept_stream: () -> Stream?

    def each_stream: () { (Stream stream) -> void } -> void

    def close: (?error_code: Integer, ?reason: String) -> void

    def closed?: () -> bool

    def turn: () -> void

    def read: (Integer stream_id, Integer max_bytes) -> String?

    def write: (Integer stream_id, String data, fin: bool) -> Integer

    private def take_events: () -> void

    private def take: (Raiha::Next::QUIC::Event::t event) -> void

    private def arrived: (Integer stream_id) -> Integer

    private def local?: (Integer stream_id) -> bool

    private def notify: () -> void

    private def wait: [T < Object] () { () -> T? } -> T
  end

  class Stream
    PIECE: Integer

    attr_reader id: Integer

    @session: Session

    def initialize: (Session session, Integer id) -> void

    def read: (?Integer? length) -> String?

    def write: (String data) -> Integer

    def <<: (String data) -> self

    def close_write: () -> nil
  end
end
