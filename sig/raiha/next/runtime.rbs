module Raiha::Next::Runtime
  module Error
    class Base < StandardError
    end

    class Usage < Base
    end
  end

  # What a client or a server of the runtime is to its Driver.
  interface _Owner
    def route: (Raiha::Next::QUIC::Route::t route, Float now) -> void

    def turn: (Float now) -> void

    def next_timeout: () -> Float?

    def stopped: (StandardError? failure) -> void
  end

  class Driver
    attr_reader endpoint: Raiha::Next::QUIC::Endpoint
    attr_reader failure: StandardError?

    @udp: UDP
    @owner: _Owner
    @lock: Thread::Mutex
    @changed: Thread::ConditionVariable
    @dirty: bool
    @stopped: bool

    def self.clock: () -> Float

    def initialize: (Raiha::Next::QUIC::Endpoint endpoint, UDP udp, _Owner owner) -> void

    def start: () -> self

    def changed: () -> void

    def stopped?: () -> bool

    def flush: () -> void

    def stop: () -> void

    private def read: () -> void

    private def take: (Array[[String, UDP::address, UDP::ecn]] datagrams, Float now) -> Array[Raiha::Next::QUIC::Transmit]

    private def run: () -> void

    private def turn: (Float now) -> Array[Raiha::Next::QUIC::Transmit]

    private def timeout: () -> Float?

    private def fail: (StandardError error) -> void
  end

  class UDP
    type address = [String, Integer]

    RECEIVE_BATCH: Integer
    MAX_DATAGRAM: Integer
    BUFFER: Integer
    type ecn = Raiha::Next::QUIC::ecn | :ce

    ECN: Hash[Integer, ecn]
    MARKS: Hash[Symbol, Integer]
    DROPPED: Array[singleton(SystemCallError)]

    @socket: UDPSocket
    @family: Integer

    def self.bind: (String host, Integer port) -> UDP

    def initialize: (UDPSocket socket) -> void

    def local_address: () -> address

    def send: (Raiha::Next::QUIC::Transmit transmit) -> bool

    def receive: () -> Array[[String, address, ecn]]

    def wait_readable: (?(Float | Integer)? timeout) -> bool

    def close: () -> void

    def closed?: () -> bool

    private def datagrams: (Raiha::Next::QUIC::Transmit transmit) -> Array[String]

    private def mark: (Symbol ecn, String host) -> Socket::AncillaryData?

    private def ecn: (Array[Socket::AncillaryData] controls) -> ecn
  end
end

module Raiha::Next::Runtime
  class StreamReset < StandardError
    attr_reader stream_id: Integer
    attr_reader error_code: Integer

    def initialize: (Integer stream_id, Integer error_code) -> void
  end

  class Session
    class Track < Struct[Integer | bool | nil]
      attr_accessor reset: Integer?
      attr_accessor stop: Integer?
      attr_accessor reading: bool
      attr_accessor writing: bool

      def self.new: (Integer? reset, Integer? stop, bool reading, bool writing) -> Track

      def []=: (:reading | :writing part, bool value) -> bool
    end

    MAX_ACK_DELAY: Float

    attr_reader connection: Raiha::Next::QUIC::Connection

    @driver: Driver
    @role: :client | :server
    @lock: Thread::Mutex
    @changed: Thread::ConditionVariable
    @waiting: Integer
    @tracks: Hash[Integer, Track]
    @incoming: Array[Integer]
    @peer_next: Array[Integer]
    @aborted: StandardError?
    @stopping: bool

    def initialize: (Raiha::Next::QUIC::Connection connection, Driver driver, role: :client | :server) -> void

    def open_stream: (?direction: :bidi | :uni) -> Stream

    def wait_acknowledged: (Float | Integer seconds) -> bool

    def close_when_acknowledged: (?error_code: Integer) -> void

    def wait_handshake: () -> nil

    def accept_stream: () -> Stream?

    def each_stream: () { (Stream stream) -> void } -> void

    def close: (?error_code: Integer, ?reason: String) -> void

    def closed?: () -> bool

    def abort: (?StandardError? failure) -> void

    def stopping?: () -> bool

    def stopping!: () -> void

    def turn: () -> void

    def read: (Integer stream_id, Integer max_bytes) -> String?

    def write: (Integer stream_id, String data, fin: bool) -> Integer

    private def take_events: () -> void

    private def take: (Raiha::Next::QUIC::Event::t event) -> void

    private def arrived: (Integer stream_id) -> void

    private def over: (Integer stream_id, :reading | :writing part) -> void

    private def local?: (Integer stream_id) -> bool

    private def notify: () -> void

    private def wait: [T < Object] () { () -> T? } -> T
                    | [T < Object] (deadline: Float) { () -> T? } -> T?
  end

  class Stream
    PIECE: Integer

    attr_reader id: Integer

    @session: Session

    def initialize: (Session session, Integer id) -> void

    def read: (?Integer? length) -> String?

    def write: (String data) -> Integer

    def <<: (String data) -> self

    def close_write: () -> nil
  end
end

module Raiha::Next::Runtime
  class ConnectError < StandardError
    attr_reader errors: Array[[UDP::address | String, StandardError]]

    def initialize: (String host, Integer port, Array[[UDP::address | String, StandardError]] errors) -> void
  end

  class Client
    CONNECT_TIMEOUT: Float

    @config: Raiha::Next::QUIC::Config
    @tls_config: Raiha::Next::TLS::Config
    @keyring: Raiha::Next::TLS::Keyring
    @connect_timeout: Float | Integer
    @session: Session?
    @deadline: Float?
    @qlog: Qlog?
    @trace: Qlog::Pending?

    def self.connect: [T] (String host, Integer port, config: Raiha::Next::QUIC::Config, tls_config: Raiha::Next::TLS::Config,
                           keyring: Raiha::Next::TLS::Keyring, ?server_name: String, ?connect_timeout: Float | Integer,
                           ?qlog_dir: String?) { (Session session) -> T } -> T

    def initialize: (config: Raiha::Next::QUIC::Config, tls_config: Raiha::Next::TLS::Config, keyring: Raiha::Next::TLS::Keyring,
                     ?connect_timeout: Float | Integer, ?qlog_dir: String?) -> void

    def connect: [T] (String host, Integer port, ?server_name: String) { (Session session) -> T } -> T

    def route: (Raiha::Next::QUIC::Route::t route, Float now) -> nil

    def turn: (Float now) -> void

    def next_timeout: () -> Float?

    def stopped: (StandardError? failure) -> void

    private def finish: (Driver driver, Session session) -> void

    private def resolve: (String host, Integer port) -> Array[UDP::address]

    private def attempt: (UDP::address address, String server_name) -> [Driver, Session]
  end
end

module Raiha::Next::Runtime
  class Server
    MAX_CONNECTIONS: Integer
    STOP_TIMEOUT: Integer

    @config: Raiha::Next::QUIC::Config
    @tls_config: Raiha::Next::TLS::Config
    @keyring: Raiha::Next::TLS::Keyring
    @host: String
    @port: Integer
    @max_connections: Integer
    @qlog: Qlog?
    @traces: Hash[Session, Qlog::Pending]
    @sessions: Array[Session]
    @started: Hash[Session, true]
    @handler: (^(Session) -> void)?
    @driver: Driver?
    @udp: UDP?
    @lock: Thread::Mutex
    @stopped: Thread::ConditionVariable
    @stop: [Float | Integer, Integer]?
    @stop_deadline: Float?
    @wake: IO?

    def initialize: (config: Raiha::Next::QUIC::Config, tls_config: Raiha::Next::TLS::Config, keyring: Raiha::Next::TLS::Keyring,
                     ?host: String, ?port: Integer, ?max_connections: Integer, ?qlog_dir: String?) -> void

    def run: () { (Session session) -> void } -> nil

    def local_address: () -> UDP::address?

    def reconfigure: (tls_config: Raiha::Next::TLS::Config, keyring: Raiha::Next::TLS::Keyring) -> nil

    def stop: (?timeout: Float | Integer, ?error_code: Integer) -> nil

    def route: (Raiha::Next::QUIC::Route::t route, Float now) -> void

    def turn: (Float now) -> void

    def next_timeout: () -> Float?

    def stopped: (StandardError? failure) -> void

    private def driver!: () -> Driver

    private def start: (Session session) -> void

    private def wake_on: (IO reader, Driver driver) -> void

    private def stopping: (Float now) -> void
  end
end

module Raiha::Next::Runtime
  class Qlog
    BUDGET: Integer

    class Pending
      attr_reader path: String

      @data: String
      @file: File?
      @over: bool

      def initialize: (String path) -> void

      def write: (*String strings) -> Integer

      def over!: () -> void

      def flush: () -> bool
    end

    attr_reader budget: Raiha::Next::QUIC::Qlog::Budget

    @dir: String
    @pending: Array[Pending]

    def self.budget: () -> Raiha::Next::QUIC::Qlog::Budget

    def initialize: (String dir, ?budget: Raiha::Next::QUIC::Qlog::Budget) -> void

    def trace: (:client | :server vantage_point, String name) -> [Raiha::Next::QUIC::Qlog::Tracer, Pending]

    def flush: () -> nil
  end
end
