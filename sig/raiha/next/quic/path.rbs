module Raiha::Next::QUIC
  class Path
    attr_reader rtt: Recovery::RttEstimator
    attr_reader congestion: Congestion::_Controller
    attr_reader bytes_in_flight: Integer
    attr_reader ack_eliciting_in_flight: Integer
    attr_reader packets_in_flight: Integer
    attr_reader max_datagram_size: Integer

    @config: Config
    @app_limited: bool
    @abandoned: bool
    @tracer: _Tracer?
    @ecn_testing_sent: Integer
    @ecn_testing_lost: Integer
    @pacer: Pacer
    @pacing_release_at: Float?
    @rate_meter: Recovery::RateMeter

    attr_reader ecn_state: :testing | :capable | :failed

    def initialize: (config: Config, ?max_datagram_size: Integer, ?tracer: _Tracer?) -> void
    def start_over: () -> void
    def add_in_flight: (sent_bytes: Integer, ack_eliciting: bool, now: Float) -> void
    def paced?: (Integer size, Float now) -> bool
    attr_reader pacing_release_at: Float?
    def delivered: (Integer bytes, largest: Integer, now: Float) -> void
    def delivery_rate: () -> Float?
    def remove_in_flight: (sent_bytes: Integer, ack_eliciting: bool) -> void
    def app_limited?: () -> bool
    def transmission_stopped: (Symbol reason, waiting: bool, next_packet_number: Integer) -> bool
    def update_max_datagram_size: (Integer max_datagram_size, now: Float) -> void
    def window_packets: () -> Integer
    def abandon: () -> void
    def abandoned?: () -> bool
    def ecn: () -> (:ect0 | :not_ect)
    def ecn_sent: () -> void
    def ecn_lost: (Integer count, now: Float) -> void
    def ecn_validated: (now: Float) -> void
    def ecn_failed: (now: Float) -> void

    private def change_ecn_state: (:testing | :capable | :failed state, Float now) -> void
  end
end
