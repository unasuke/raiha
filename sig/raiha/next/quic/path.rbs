module Raiha::Next::QUIC
  class Path
    attr_reader rtt: Recovery::RttEstimator
    attr_reader congestion: Congestion::_Controller
    attr_reader bytes_in_flight: Integer
    attr_reader ack_eliciting_in_flight: Integer
    attr_reader max_datagram_size: Integer

    @app_limited: bool
    @abandoned: bool

    def initialize: (config: Config, ?max_datagram_size: Integer, ?tracer: _Tracer?) -> void
    def add_in_flight: (sent_bytes: Integer, ack_eliciting: bool, now: Float) -> void
    def remove_in_flight: (sent_bytes: Integer, ack_eliciting: bool) -> void
    def app_limited?: () -> bool
    def transmission_stopped: (Symbol reason) -> bool
    def update_max_datagram_size: (Integer max_datagram_size, now: Float) -> void
    def window_packets: () -> Integer
    def abandon: () -> void
    def abandoned?: () -> bool
  end
end
