module Raiha::Next::QUIC
  class TLSBinding
    # What the binding tells the connection it binds.
    interface _Connection
      def install_keys: (PacketProtection::level level, PacketProtection::direction direction, secret: String,
                         suite: ::Raiha::Next::TLS::CipherSuite) -> void
      def peer_transport_parameters: (String data) -> void
      def handshake_completed: (::Raiha::Next::TLS::Event::HandshakeComplete event) -> void
      def tls_failed: (Integer code, Symbol reason) -> void
      def tls_event: (::Raiha::Next::TLS::Event::t event) -> void
    end

    LEVEL: Hash[::Raiha::Next::TLS::epoch, PacketProtection::level]
    EPOCH: Hash[PacketProtection::level, ::Raiha::Next::TLS::epoch]
    RANK: Hash[PacketProtection::level, Integer]
    SPACES: Hash[PacketProtection::level, space]
    LEVEL_OF_SPACE: Hash[space, PacketProtection::level]
    MIN_CRYPTO_BUFFER: Integer
    TRANSPORT_PARAMETERS: Integer

    @connection: _Connection
    @machine: ::Raiha::Next::TLS::Handshake::Machine
    @profile: ::Raiha::Next::TLS::Profile
    @streams: Hash[PacketProtection::level, CryptoStream]

    def self.client: (connection: _Connection, config: ::Raiha::Next::TLS::Config, keyring: ::Raiha::Next::TLS::Keyring,
                      server_name: String, transport_parameters: TransportParameters, time: Time,
                      ?tracer: ::Raiha::Next::TLS::Trace::_Tracer?, ?keylog: ::Raiha::Next::TLS::Keylog::_Writer?) -> TLSBinding
    def self.server: (connection: _Connection, config: ::Raiha::Next::TLS::Config, keyring: ::Raiha::Next::TLS::Keyring,
                      transport_parameters: TransportParameters, time: Time, ?client_hello: ::Raiha::Next::TLS::Handshake::Accepted?,
                      ?tracer: ::Raiha::Next::TLS::Trace::_Tracer?, ?keylog: ::Raiha::Next::TLS::Keylog::_Writer?) -> TLSBinding
    private def self.check: (::Raiha::Next::TLS::Config config) -> void
    private def self.extension: (TransportParameters transport_parameters) -> ::Raiha::Next::TLS::Extension::Opaque

    def initialize: (_Connection connection, ::Raiha::Next::TLS::Handshake::Machine machine, ::Raiha::Next::TLS::Profile profile,
                     ?consumed: Integer) -> void
    def complete?: () -> bool
    def receive_crypto: (PacketProtection::level level, Wire::Frame::Crypto frame, time: Time) -> void
    def pump: () -> void
    def crypto_pending?: (PacketProtection::level level) -> bool
    def next_crypto_frame: (PacketProtection::level level, Integer room) -> [Wire::Frame::Crypto, Recovery::Duty::Crypto]?
    def crypto_acked: (Recovery::Duty::Crypto duty) -> void
    def crypto_lost: (Recovery::Duty::Crypto duty) -> void
    def discard_level: (PacketProtection::level level) -> CryptoStream?
    def discard: () -> nil

    private def read_level: () -> PacketProtection::level
    private def feed: (Time time) -> void
    private def stream_of: (Recovery::Duty::Crypto duty) -> CryptoStream?
    private def error_code: (Symbol? alert, Symbol reason) -> Integer
  end
end
