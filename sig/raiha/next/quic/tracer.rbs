module Raiha::Next::QUIC
  # A packet number space.
  type space = :initial | :handshake | :application_data

  type metric = Integer | Float | Symbol | nil

  interface _Tracer
    def packet_lost: (packet_number: Integer, space: space, trigger: Symbol, mtu_probe: bool, now: Float) -> void
    def metrics_updated: (now: Float, **metric metrics) -> void
    def timer_updated: (timer_type: Symbol, event_type: Symbol, space: space?, delta: Float?, now: Float) -> void
    def ecn_state_updated: (old: Symbol, new: Symbol, now: Float) -> void
    def recovery_parameters_set: (now: Float, **metric parameters) -> void
    def spurious_loss: (packet_number: Integer, space: space, now: Float) -> void
    def congestion_state_updated: (old: Symbol, new: Symbol, now: Float) -> void
  end

  module Tracer
    def packet_lost: (packet_number: Integer, space: space, trigger: Symbol, mtu_probe: bool, now: Float) -> nil
    def metrics_updated: (now: Float, **metric metrics) -> nil
    def timer_updated: (timer_type: Symbol, event_type: Symbol, space: space?, delta: Float?, now: Float) -> nil
    def ecn_state_updated: (old: Symbol, new: Symbol, now: Float) -> nil
    def recovery_parameters_set: (now: Float, **metric parameters) -> nil
    def spurious_loss: (packet_number: Integer, space: space, now: Float) -> nil
    def congestion_state_updated: (old: Symbol, new: Symbol, now: Float) -> nil
  end
end
