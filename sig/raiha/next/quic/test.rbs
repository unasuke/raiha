module Raiha::Next::QUIC::Test
  module CongestionContract : _ContractTest
    # What a test class that includes the contract provides: Minitest's
    # assertions and the algorithm under test.
    interface _ContractTest
      def congestion_control: () -> ::Raiha::Next::QUIC::Congestion::_Algorithm
      def assert_operator: (top left, Symbol operator, top right, ?String? message) -> true
      def assert_equal: (top expected, top actual, ?String? message) -> true
      def assert_includes: (top collection, top object, ?String? message) -> true
      def assert_kind_of: (Module klass, top object, ?String? message) -> true
    end

    MAX_DATAGRAM_SIZE: Integer
    KNOWN_STATES: Array[Symbol]
    SEED: Integer

    def known_congestion_states: () -> Array[Symbol]
    def test_congestion_contract_window_stays_above_the_minimum: () -> void
    def test_congestion_contract_loss_shrinks_the_window: () -> void
    def test_congestion_contract_persistent_congestion_takes_the_minimum: () -> void
    def test_congestion_contract_minimum_follows_the_datagram_size: () -> void
    def test_congestion_contract_no_growth_while_application_limited: () -> void
    def test_congestion_contract_states_are_known: () -> void
    def test_congestion_contract_metrics_carry_the_window: () -> void

    private def new_controller: () -> ::Raiha::Next::QUIC::Congestion::_Controller
    private def acknowledge: (::Raiha::Next::QUIC::Congestion::_Controller cc, Integer bytes, sent_at: Float, now: Float, ?app_limited: bool) -> void
  end
end

module Raiha::Next::QUIC::Test
  class VirtualClock
    attr_reader now: Float

    def initialize: (?now: Float) -> void
    def advance_to: (Float time) -> Float
    def advance: (Float seconds) -> Float
  end

  class Datagram < Data
    attr_reader payload: String
    attr_reader source: ::Raiha::Next::QUIC::address
    attr_reader destination: ::Raiha::Next::QUIC::address
    attr_reader ecn: ::Raiha::Next::QUIC::ecn | :ce

    def self.new: (payload: String, source: ::Raiha::Next::QUIC::address, destination: ::Raiha::Next::QUIC::address,
                   ecn: ::Raiha::Next::QUIC::ecn | :ce) -> instance
                | (String payload, ::Raiha::Next::QUIC::address source, ::Raiha::Next::QUIC::address destination,
                   ::Raiha::Next::QUIC::ecn | :ce ecn) -> instance
  end

  # What a network carries datagrams between.
  interface _Node
    def receive: (String payload, from: ::Raiha::Next::QUIC::address, to: ::Raiha::Next::QUIC::address?,
                  ecn: ::Raiha::Next::QUIC::ecn | :ce, now: Float) -> top
    def each_transmit: (now: Float) { (::Raiha::Next::QUIC::Transmit) -> void } -> top
    def next_timeout: () -> Float?
    def handle_timeout: (now: Float) -> top
  end

  # One direction of a link.
  interface _Path
    def submit: (Datagram datagram, now: Float) -> top
    def each_delivery: (now: Float) { (Datagram) -> void } -> top
    def next_timeout: () -> Float?
  end

  # A path model: a value that starts the state of one direction.
  interface _Model
    def start: (random: Random) -> _Path
  end

  type model = _Model | Array[_Model]

  class Network
    MAX_ROUNDS: Integer

    class Stuck < StandardError
    end

    @random: Random
    @clock: VirtualClock
    @nodes: Hash[::Raiha::Next::QUIC::address, _Node]
    @addresses: Hash[_Node, ::Raiha::Next::QUIC::address]
    @links: Hash[[::Raiha::Next::QUIC::address, ::Raiha::Next::QUIC::address], _Path]
    @outside: Hash[::Raiha::Next::QUIC::address, ::Raiha::Next::QUIC::address]
    @inside: Hash[::Raiha::Next::QUIC::address, ::Raiha::Next::QUIC::address]
    @direct: Direct

    attr_reader clock: VirtualClock

    def initialize: (seed: Integer, ?clock: VirtualClock) -> void
    def now: () -> Float
    def add: [N < _Node] (N node, address: ::Raiha::Next::QUIC::address) -> N
    def address_of: (_Node node) -> ::Raiha::Next::QUIC::address
    def add_address: (_Node node, address: ::Raiha::Next::QUIC::address) -> self
    def rebind: (::Raiha::Next::QUIC::address inside, to: ::Raiha::Next::QUIC::address) -> self
    def add_server: (config: ::Raiha::Next::QUIC::Config, tls_config: ::Raiha::Next::TLS::Config, keyring: ::Raiha::Next::TLS::Keyring,
                     time: Time, address: ::Raiha::Next::QUIC::address, ?retry_unvalidated: bool, ?tracer: ::Raiha::Next::QUIC::_Tracer?,
                     ?anti_replay: ::Raiha::Next::TLS::AntiReplay::_AntiReplay?) -> Server
    def link: (_Node a, _Node b, ?model: model?, ?forward: model?, ?reverse: model?) -> self
    def run_until: (?within: Float) { () -> boolish } -> bool
    def advance: (Float seconds) -> void

    private def settle: () -> void
    private def transmit_from: (_Node node, ::Raiha::Next::QUIC::Transmit transmit) -> void
    private def deliver: (Datagram datagram) -> void
    private def inside: (::Raiha::Next::QUIC::address address) -> ::Raiha::Next::QUIC::address?
    private def take: (::Raiha::Next::QUIC::address address, _Node node) -> _Node
    private def each_path: () { (_Path) -> void } -> void
    private def next_event: () -> Float?
    private def start: (model model) -> _Path

    class Direct
      @queue: Array[Datagram]

      def initialize: () -> void
      def submit: (Datagram datagram, now: Float) -> Array[Datagram]
      def each_delivery: (now: Float) { (Datagram) -> void } -> void
      def next_timeout: () -> nil
    end

    class Chain
      @stages: Array[_Path]

      def initialize: (Array[_Path] stages) -> void
      def submit: (Datagram datagram, now: Float) -> top
      def each_delivery: (now: Float) { (Datagram) -> void } -> top
      def next_timeout: () -> Float?
    end
  end
end

module Raiha::Next::QUIC::Test
  class RandomLoss < Data
    attr_reader rate: Float

    def self.new: (rate: Float) -> instance
                | (Float rate) -> instance
    def initialize: (rate: Float) -> void
    def start: (random: Random) -> State

    class State
      @rate: Float
      @random: Random
      @queue: Array[Datagram]

      def initialize: (Float rate, Random random) -> void
      def submit: (Datagram datagram, now: Float) -> void
      def each_delivery: (now: Float) { (Datagram) -> void } -> void
      def next_timeout: () -> nil
    end
  end
end

module Raiha::Next::QUIC::Test
  class Reorder < Data
    attr_reader rate: Float
    attr_reader hold: Float

    def self.new: (rate: Float, ?hold: Float) -> instance
                | (Float rate, ?Float hold) -> instance
    def initialize: (rate: Float, ?hold: Float) -> void
    def start: (random: Random) -> State

    class State
      @rate: Float
      @hold: Float
      @random: Random
      @queue: Array[Datagram]
      @held: [Datagram, Float]?

      def initialize: (Float rate, Float hold, Random random) -> void
      def submit: (Datagram datagram, now: Float) -> void
      def each_delivery: (now: Float) { (Datagram) -> void } -> void
      def next_timeout: () -> Float?
    end
  end
end

module Raiha::Next::QUIC::Test
  class Bottleneck < Data
    attr_reader bandwidth: Integer
    attr_reader delay: Float
    attr_reader queue: Integer
    attr_reader ce_threshold: Integer?

    def self.new: (bandwidth: Integer, delay: Float, queue: Integer, ?ce_threshold: Integer?) -> instance
                | (Integer bandwidth, Float delay, Integer queue, ?Integer? ce_threshold) -> instance
    def initialize: (bandwidth: Integer, delay: Float, queue: Integer, ?ce_threshold: Integer?) -> void
    def start: (random: Random) -> State

    class State
      @model: Bottleneck
      @waiting: Array[[Float, Integer]]
      @busy_until: Float
      @arrivals: Array[[Float, Datagram]]

      def initialize: (Bottleneck model) -> void
      def submit: (Datagram datagram, now: Float) -> void
      def each_delivery: (now: Float) { (Datagram) -> void } -> void
      def next_timeout: () -> Float?
    end
  end
end

module Raiha::Next::QUIC::Test
  class Server
    @endpoint: ::Raiha::Next::QUIC::Endpoint
    @tls_config: ::Raiha::Next::TLS::Config
    @keyring: ::Raiha::Next::TLS::Keyring
    @retry_unvalidated: bool
    @tracer: ::Raiha::Next::QUIC::_Tracer?
    @anti_replay: ::Raiha::Next::TLS::AntiReplay::_AntiReplay?
    @transmits: Array[::Raiha::Next::QUIC::Transmit]

    attr_reader endpoint: ::Raiha::Next::QUIC::Endpoint

    def initialize: (::Raiha::Next::QUIC::Endpoint endpoint, tls_config: ::Raiha::Next::TLS::Config, keyring: ::Raiha::Next::TLS::Keyring,
                     ?retry_unvalidated: bool, ?tracer: ::Raiha::Next::QUIC::_Tracer?,
                     ?anti_replay: ::Raiha::Next::TLS::AntiReplay::_AntiReplay?) -> void
    def receive: (String payload, from: ::Raiha::Next::QUIC::address, to: ::Raiha::Next::QUIC::address?,
                  ecn: ::Raiha::Next::QUIC::ecn | :ce, now: Float) -> void
    def each_transmit: (now: Float) { (::Raiha::Next::QUIC::Transmit) -> void } -> void
    def next_timeout: () -> Float?
    def handle_timeout: (now: Float) -> void
    def connections: () -> Array[::Raiha::Next::QUIC::Connection]

    private def dispatch: (::Raiha::Next::QUIC::Route::t? route, Float now) -> void
  end
end
