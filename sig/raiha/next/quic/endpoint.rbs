module Raiha::Next::QUIC
  class Endpoint
    MAX_RESET_LENGTH: Integer
    RESET_BURST: Float
    RESET_RATE: Float
    RESET_ADDRESSES: Integer
    RESET_TOTAL_BURST: Float
    RESET_TOTAL_RATE: Float
    HANDLE_LIFETIME: Float
    HANDLE_BUFFER: Integer
    HANDLES_BUFFER: Integer
    CONNECTION_ID_ATTEMPTS: Integer

    class Handle
      @remote: address
      @version: Version
      @destination_connection_id: String
      @source_connection_id: String
      @original_destination_connection_id: String
      @retry_source_connection_id: String?
      @expires_at: Float
      @datagrams: Array[[String, address, address?, ecn | :ce]]
      @buffered: Integer
      @acceptor: ::Raiha::Next::TLS::Handshake::Acceptor?
      @keys: Crypto::Keys?
      @crypto: CryptoStream
      @largest: Integer?
      @violation: Violation?
      @offered: bool

      attr_reader remote: address
      attr_reader version: Version
      attr_reader destination_connection_id: String
      attr_reader source_connection_id: String
      attr_reader original_destination_connection_id: String
      attr_reader retry_source_connection_id: String?
      attr_reader expires_at: Float
      attr_reader datagrams: Array[[String, address, address?, ecn | :ce]]
      attr_reader buffered: Integer

      def initialize: (remote: address, version: Version, destination_connection_id: String, source_connection_id: String,
                       original_destination_connection_id: String, retry_source_connection_id: String?, expires_at: Float) -> void
      def keep: (String datagram, from: address, to: address?, ecn: ecn | :ce) -> void
      def expired?: (Float now) -> bool
      def admitted?: () -> bool
      def admit: (time: Time, dcid_length: Integer) -> void
      def read: (String datagram, time: Time, dcid_length: Integer) -> void
      def error: () -> ConnectionError?
      def failed?: () -> bool
      def local: () -> address?
      def accepted: () -> ::Raiha::Next::TLS::Handshake::Accepted?
      def take_client_hello: () -> ::Raiha::Next::TLS::Handshake::Accepted?

      private def parse: (String datagram, Integer offset, Integer dcid_length) -> Wire::Packet::Parsed?

      private def instance_variables_to_inspect: () -> Array[Symbol]
    end

    @config: Config
    @random: Crypto::_Random
    @time: Time
    @created_at: Float
    @retry_token_key: String
    @stateless_reset_key: String
    @connections: Hash[String, Connection]
    @handles: Hash[String, Handle]
    @buffered: Integer
    @transmits: Array[Transmit]
    @resets: Hash[address, [Float, Float]]
    @reset_total: Float
    @reset_total_at: Float

    def self.server: (config: Config, random: Crypto::_Random, time: Time, now: Float) -> Endpoint

    def initialize: (config: Config, random: Crypto::_Random, time: Time, now: Float) -> void
    def receive: (String datagram, from: address, ?to: address?, ?ecn: ecn | :ce, now: Float) -> Route::t?
    def each_transmit: (now: Float) { (Transmit) -> void } -> void
    def next_timeout: () -> Float?
    def handle_timeout: (now: Float) -> void
    def admit: (Handle handle, now: Float) -> Route::ClientHello?
    def accept: (Handle handle, tls_config: ::Raiha::Next::TLS::Config, keyring: ::Raiha::Next::TLS::Keyring, now: Float, ?tracer: _Tracer?,
                 ?keylog: ::Raiha::Next::TLS::Keylog::_Writer?) -> Connection
    def each_connection: () { (Connection) -> void } -> void
    def connection_count: () -> Integer

    private def connections: () -> Array[Connection]
    private def route: (Wire::header header, String datagram, from: address, to: address?, ecn: ecn | :ce, now: Float) -> Route::t?
    private def offer: (Wire::LongHeader header, String datagram, from: address, to: address?, ecn: ecn | :ce, now: Float) -> Route::t
    private def keep: (Handle handle, String datagram, from: address, to: address?, ecn: ecn | :ce) -> Route::Drop?
    private def client_hello: (Handle handle) -> Route::ClientHello?
    private def close: (Handle handle, ConnectionError error) -> void
    private def new_connection_id: () -> String
    private def pending!: (Handle handle) -> void
    private def forget: (Handle handle) -> void
    private def negotiate: (Wire::UnsupportedVersion packet, String datagram, address from, address? to) -> Route::t
    private def reset: (String dcid, String datagram, address from, address? to, Float now) -> Route::t
    private def take_reset: (address address, Float now) -> bool
    private def transmit: (String payload, address destination, address? source) -> Transmit
    private def wall_clock: (Float now) -> Time
    private def instance_variables_to_inspect: () -> Array[Symbol]
  end
end
