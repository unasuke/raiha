module Raiha::Next::TLS
  class Config
    type role = :client | :server
    type client_auth = :none | :optional | :required

    DEFAULT_CIPHER_SUITES: Array[Symbol]
    DEFAULT_GROUPS: Array[Symbol]
    DEFAULT_SIGNATURE_ALGORITHMS: Array[Symbol]
    DEFAULT_SIGNATURE_ALGORITHMS_CERT: Array[Symbol]
    RESERVED_EXTENSIONS: Array[Integer]
    EXPORTER_LABEL_LENGTH: Range[Integer]
    CIPHER_SUITES_BY_NAME: Hash[Symbol, CipherSuite]
    GROUPS_BY_NAME: Hash[Symbol, Integer]
    SCHEMES_BY_NAME: Hash[Symbol, SignatureScheme]

    def self.client: (?profile: Profile, ?cipher_suites: Array[Symbol], ?groups: Array[Symbol],
                      ?signature_algorithms: Array[Symbol], ?signature_algorithms_cert: Array[Symbol],
                      ?alpn: Array[String], ?registry: Extension::Registry, ?extensions: Array[Extension::_Extension],
                      ?max_handshake_message_size: Integer, ?max_certificate_message_size: Integer,
                      ?max_certificate_chain_length: Integer, ?permute_extensions: boolish, ?grease: boolish,
                      ?exporter_labels: Array[String], ?record_size_limit: Integer?, ?trust_anchors: Array[String],
                      ?verify_flags: Integer, ?client_auth: client_auth, ?certificate_authorities: boolish,
                      ?require_server_name: boolish) -> Config
    def self.server: (?profile: Profile, ?cipher_suites: Array[Symbol], ?groups: Array[Symbol],
                      ?signature_algorithms: Array[Symbol], ?signature_algorithms_cert: Array[Symbol],
                      ?alpn: Array[String], ?registry: Extension::Registry, ?extensions: Array[Extension::_Extension],
                      ?max_handshake_message_size: Integer, ?max_certificate_message_size: Integer,
                      ?max_certificate_chain_length: Integer, ?permute_extensions: boolish, ?grease: boolish,
                      ?exporter_labels: Array[String], ?record_size_limit: Integer?, ?trust_anchors: Array[String],
                      ?verify_flags: Integer, ?client_auth: client_auth, ?certificate_authorities: boolish,
                      ?require_server_name: boolish) -> Config
    def self.deterministic: (?profile: Profile, ?cipher_suites: Array[Symbol], ?groups: Array[Symbol],
                             ?signature_algorithms: Array[Symbol], ?signature_algorithms_cert: Array[Symbol],
                             ?alpn: Array[String], ?registry: Extension::Registry,
                             ?extensions: Array[Extension::_Extension], ?max_handshake_message_size: Integer,
                             ?max_certificate_message_size: Integer, ?max_certificate_chain_length: Integer,
                             ?exporter_labels: Array[String], ?record_size_limit: Integer?,
                             ?trust_anchors: Array[String], ?verify_flags: Integer) -> Config
    def self.check_extensions: (Array[Extension::_Extension] extensions, Extension::Registry registry) -> void

    attr_reader role: role
    attr_reader profile: Profile
    attr_reader cipher_suites: Array[Symbol]
    attr_reader groups: Array[Symbol]
    attr_reader signature_algorithms: Array[Symbol]
    attr_reader signature_algorithms_cert: Array[Symbol]
    attr_reader alpn: Array[String]
    attr_reader registry: Extension::Registry
    attr_reader extensions: Array[Extension::_Extension]
    attr_reader max_handshake_message_size: Integer
    attr_reader max_certificate_message_size: Integer
    attr_reader max_certificate_chain_length: Integer
    attr_reader permute_extensions: bool
    attr_reader grease: bool
    attr_reader exporter_labels: Array[String]
    attr_reader record_size_limit: Integer?
    attr_reader trust_anchors: Array[String]
    attr_reader verify_flags: Integer
    attr_reader client_auth: client_auth
    attr_reader certificate_authorities: bool
    attr_reader require_server_name: bool
    attr_reader cipher_suite_ids: Array[Integer]
    attr_reader group_ids: Array[Integer]
    attr_reader signature_algorithm_ids: Array[Integer]
    attr_reader signature_algorithm_cert_ids: Array[Integer]

    def initialize: (role: role, ?profile: Profile, ?cipher_suites: Array[Symbol], ?groups: Array[Symbol],
                     ?signature_algorithms: Array[Symbol], ?signature_algorithms_cert: Array[Symbol],
                     ?alpn: Array[String], ?registry: Extension::Registry, ?extensions: Array[Extension::_Extension],
                     ?max_handshake_message_size: Integer, ?max_certificate_message_size: Integer,
                     ?max_certificate_chain_length: Integer, ?permute_extensions: boolish, ?grease: boolish,
                     ?exporter_labels: Array[String], ?record_size_limit: Integer?, ?trust_anchors: Array[String],
                     ?verify_flags: Integer, ?client_auth: client_auth, ?certificate_authorities: boolish,
                     ?require_server_name: boolish) -> void

    def client?: () -> bool
    def server?: () -> bool
    def with: (?profile: Profile, ?cipher_suites: Array[Symbol], ?groups: Array[Symbol],
               ?signature_algorithms: Array[Symbol], ?signature_algorithms_cert: Array[Symbol], ?alpn: Array[String],
               ?registry: Extension::Registry, ?extensions: Array[Extension::_Extension],
               ?max_handshake_message_size: Integer, ?max_certificate_message_size: Integer,
               ?max_certificate_chain_length: Integer, ?permute_extensions: boolish, ?grease: boolish,
               ?exporter_labels: Array[String], ?record_size_limit: Integer?, ?trust_anchors: Array[String],
               ?verify_flags: Integer, ?client_auth: client_auth, ?certificate_authorities: boolish,
               ?require_server_name: boolish) -> Config

    private def names: [T] (Symbol setting, Array[Symbol] given, Hash[Symbol, T] table) -> Array[Symbol]
    private def check_alpn: (Array[String] alpn) -> Array[String]
    private def check_extensions: (Array[Extension::_Extension] extensions, Extension::Registry registry) -> Array[Extension::_Extension]
    private def check_exporter_labels: (Array[String] labels) -> Array[String]
    private def positive: (Symbol setting, Integer value) -> Integer
  end
end
