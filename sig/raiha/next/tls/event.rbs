module Raiha::Next::TLS
  module Event
    class HandshakeComplete < Data
      attr_reader server_name: String?
      attr_reader alpn: String?
      attr_reader cipher_suite: Symbol
      attr_reader group: Symbol?
      attr_reader resumed: bool
      attr_reader early_data_accepted: bool
      attr_reader peer_certificates: Array[::OpenSSL::X509::Certificate]
      attr_reader peer_verified: bool

      def self.new: (server_name: String?, alpn: String?, cipher_suite: Symbol, group: Symbol?, resumed: bool,
                     early_data_accepted: bool, peer_certificates: Array[::OpenSSL::X509::Certificate],
                     peer_verified: bool) -> instance
    end

    class EarlyDataRejected < Data
      attr_reader reason: Symbol

      def self.new: (reason: Symbol) -> instance
                  | (Symbol reason) -> instance
    end

    class SessionNotOffered < Data
      DISCARD_REASONS: Array[Symbol]

      attr_reader reason: Symbol

      def self.new: (reason: Symbol) -> instance
                  | (Symbol reason) -> instance
      def discard?: () -> bool
    end

    class PeerExtension < Data
      attr_reader type: Integer
      attr_reader data: String
      attr_reader message: Integer

      def self.new: (type: Integer, data: String, message: Integer) -> instance
                  | (Integer type, String data, Integer message) -> instance
    end

    class Failed < Data
      attr_reader alert: Symbol?
      attr_reader reason: Symbol

      def self.new: (alert: Symbol?, reason: Symbol) -> instance
                  | (Symbol? alert, Symbol reason) -> instance
    end

    type t = HandshakeComplete | EarlyDataRejected | SessionNotOffered | PeerExtension | Failed
  end
end
