module Raiha::Next::HTTP3::QPACK
  module ErrorCode
    DECOMPRESSION_FAILED: Integer
    ENCODER_STREAM_ERROR: Integer
    DECODER_STREAM_ERROR: Integer
  end

  class Malformed < StandardError
  end

  class Truncated < Malformed
  end

  class IntegerOverflow < Malformed
  end

  class TooLong < StandardError
  end

  class Reader
    MAX_INTEGER: Integer
    MAX_CONTINUATIONS: Integer

    attr_reader offset: Integer

    def initialize: (String bytes, ?Integer offset, ?Integer limit) -> void

    def eof?: () -> bool

    def integer: (Integer prefix) -> Integer

    def string: (Integer prefix, ?Integer? max) -> String

    private def peek: () -> Integer

    private def take: (Integer length) -> String

    private def u8: () -> Integer
  end

  class Writer
    def initialize: () -> void

    def integer: (Integer value, Integer prefix, ?Integer flags) -> self

    def string: (String value, Integer prefix, ?Integer flags) -> self

    def to_s: () -> String
  end

  module Huffman
    CODES: Array[[Integer, Integer]]
    BITS: Array[String]
    LENGTHS: Array[Integer]

    def self.encode: (String string) -> String

    def self.encoded_length: (String string) -> Integer

    EOS: Integer
    POISON: Integer
    NEXT_STATES: Array[Integer]
    EMITS: Array[String]
    ACCEPTING: Array[bool]

    def self.tree_of: (Array[[Integer, Integer]] codes) -> Array[Array[Integer]]

    def self.decoder_of: (Array[Array[Integer]] tree) -> [Array[Integer], Array[String], Array[bool]]

    def self.nibble_steps_of: (Array[Array[Integer]] tree) -> [Array[Integer], Array[String]]

    def self.decode: (String bytes) -> String
  end

  module StaticTable
    ENTRIES: Array[[String, String]]
    INDEX: Hash[String, Hash[String, Integer]]
    NAMES: Hash[String, Integer]

    def self.index_of: (Array[[String, String]] entries) -> Hash[String, Hash[String, Integer]]

    def self.names_of: (Array[[String, String]] entries) -> Hash[String, Integer]

    def self.entry: (Integer index) -> [String, String]?

    def self.find: (String name, String value) -> Integer?

    def self.find_name: (String name) -> Integer?
  end
end
