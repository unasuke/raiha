module Raiha::Next::HTTP3::QPACK
  module ErrorCode
    DECOMPRESSION_FAILED: Integer
    ENCODER_STREAM_ERROR: Integer
    DECODER_STREAM_ERROR: Integer
  end

  class Malformed < StandardError
  end

  class Truncated < Malformed
  end

  class IntegerOverflow < Malformed
  end

  class TooLong < StandardError
  end

  class Reader
    MAX_INTEGER: Integer
    MAX_CONTINUATIONS: Integer

    attr_reader offset: Integer

    def initialize: (String bytes, ?Integer offset, ?Integer limit) -> void

    def eof?: () -> bool

    def peek: () -> Integer

    def integer: (Integer prefix) -> Integer

    def string: (Integer prefix, ?Integer? max) -> String

    private def take: (Integer length) -> String

    private def u8: () -> Integer
  end

  class Writer
    def initialize: () -> void

    def integer: (Integer value, Integer prefix, ?Integer flags) -> self

    def string: (String value, Integer prefix, ?Integer flags) -> self

    def to_s: () -> String
  end

  module Huffman
    CODES: Array[[Integer, Integer]]
    BITS: Array[String]
    LENGTHS: Array[Integer]

    def self.encode: (String string) -> String

    def self.encoded_length: (String string) -> Integer

    EOS: Integer
    POISON: Integer
    NEXT_STATES: Array[Integer]
    EMITS: Array[String]
    ACCEPTING: Array[bool]

    def self.tree_of: (Array[[Integer, Integer]] codes) -> Array[Array[Integer]]

    def self.decoder_of: (Array[Array[Integer]] tree) -> [Array[Integer], Array[String], Array[bool]]

    def self.nibble_steps_of: (Array[Array[Integer]] tree) -> [Array[Integer], Array[String]]

    def self.decode: (String bytes) -> String
  end

  module StaticTable
    ENTRIES: Array[[String, String]]
    INDEX: Hash[String, Hash[String, Integer]]
    NAMES: Hash[String, Integer]

    def self.index_of: (Array[[String, String]] entries) -> Hash[String, Hash[String, Integer]]

    def self.names_of: (Array[[String, String]] entries) -> Hash[String, Integer]

    def self.entry: (Integer index) -> [String, String]?

    def self.find: (String name, String value) -> Integer?

    def self.find_name: (String name) -> Integer?
  end

  class DynamicTable
    ENTRY_OVERHEAD: Integer
    INITIAL_SLOTS: Integer

    attr_reader capacity: Integer
    attr_reader size: Integer
    attr_reader insert_count: Integer

    @max_capacity: Integer
    @evicted: Integer
    @ring: Array[[String, String]?]

    def initialize: (Integer max_capacity) -> void

    def max_entries: () -> Integer

    def resize: (Integer capacity) -> void

    def insert: (String name, String value) -> void

    def entry: (Integer index) -> [String, String]?

    private def evict_down_to: (Integer limit) -> void

    private def grow: () -> void
  end

  class Field < Data
    attr_reader name: String
    attr_reader value: String
    attr_reader never_indexed: bool

    def self.new: (name: String, value: String, ?never_indexed: bool) -> instance
                | (String name, String value, ?bool never_indexed) -> instance

    def initialize: (name: String, value: String, ?never_indexed: bool) -> void
  end

  class Failure < Data
    attr_reader code: Integer
    attr_reader reason: String
    attr_reader stream_id: Integer?

    def self.new: (code: Integer, reason: String, ?stream_id: Integer?) -> instance
                | (Integer code, String reason, ?Integer? stream_id) -> instance

    def initialize: (code: Integer, reason: String, ?stream_id: Integer?) -> void
  end

  class Encoder
    INDEXED_STATIC: Integer
    NAME_REFERENCE_STATIC: Integer
    NAME_REFERENCE_NEVER_INDEXED: Integer
    LITERAL_NAME: Integer
    LITERAL_NAME_NEVER_INDEXED: Integer

    @pending: String
    @failure: Failure?

    def initialize: () -> void

    def encode: (Integer stream_id, Array[Field] fields) -> String

    def receive_decoder_stream: (String bytes) -> Failure?

    def take_instructions: () -> String

    private def follow: (Reader reader) -> void

    private def represent: (Writer writer, Field field) -> Writer
  end
end
