module Raiha
  module HTTP3
    class Server
      @control_stream: Raiha::Stream?
      @qpack_encoder_stream: Raiha::Stream?
      @qpack_decoder_stream: Raiha::Stream?
      @accepted_uni_streams: Hash[Integer, Hash[Symbol, untyped]]
      @peer_settings: SettingsFrame?

      def initialize: (connection: Raiha::Connection) -> void
      def setup_control_stream: (?settings: Hash[Integer, Integer]) -> Raiha::Stream
      def setup_qpack_streams: -> nil
      def process_peer_unidirectional_streams: -> nil
      # Deprecated: use process_peer_unidirectional_streams instead.
      def receive_peer_control_stream: (Raiha::Stream stream) -> SettingsFrame?
      def receive_request: (Raiha::Stream stream) -> Request
      def send_response: (Raiha::Stream stream, status: Integer, ?headers: Array[[String, String]], ?body: String?) -> void
      def pending_request_stream: -> Raiha::Stream?
      def serve_static: (Raiha::Stream stream, Request request, root: String) -> void

      private def default_settings: -> Hash[Integer, Integer]
      private def open_unidirectional_with_type: (Integer type, ?extra_data: String?) -> Raiha::Stream
      private def consume_control_frames: (Hash[Symbol, untyped] entry) -> void
      private def peer_initiated_stream?: (Raiha::Stream stream) -> bool
      private def resolve_static_path: (String? request_path, String root) -> String?
    end
  end
end
