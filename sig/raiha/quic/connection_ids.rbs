module Raiha::QUIC
  # What makes the connection IDs an Endpoint issues.
  interface _ConnectionIDs
    def generate: (Integer length) -> String

    # The other worker that issued `connection_id`, nil for none.
    def worker_of: (String connection_id) -> Integer?
  end

  class RandomConnectionIDs
    include _ConnectionIDs

    @random: Crypto::_Random

    def initialize: (Crypto::_Random random) -> void
  end

  class WorkerConnectionIDs
    include _ConnectionIDs

    MIN_LENGTH: Integer
    MAX_WORKERS: Integer
    LABEL: String

    @random: Crypto::_Random
    @worker_id: Integer
    @worker_count: Integer
    @key: String

    def initialize: (Crypto::_Random random, worker_id: Integer, worker_count: Integer, key: String) -> void

    private def mask: (String rest) -> Integer
  end
end
